# Caching, for hosts that read a _headers file (Cloudflare): the pages, the service worker and the manuals asked again every time, so
# that an update shows at once; the build's files, whose names change with their contents, kept for a year.
# (Both rules match /assets/…: the second takes the first one's Cache-Control away before setting its own.)
/*
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# llms.txt (for AI crawlers: what olomol is) in UTF-8: Cloudflare says text/plain without a charset, and it has á, ⁺, Λ
/llms.txt
  Content-Type: text/plain; charset=utf-8
