{
  "name": "olomol",
  "version": "0.6.0",
  "doi": "10.5281/zenodo.24432009",
  "doiVersion": "0.6.0",
  "conceptDoi": "10.5281/zenodo.24104909",
  "description": "Browser-based chemical structure and mechanism drawing for teaching, with RDKit.js and Indigo.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.14.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pages.mjs && node scripts/pwa.mjs",
    "build:locked": "vite build && node scripts/pages.mjs && node scripts/lock.mjs && node scripts/pwa.mjs",
    "preview": "vite preview",
    "check": "node scripts/browser-check.mjs",
    "check:formats": "node --import ./scripts/formats/node-setup.mjs scripts/formats/readers.mjs",
    "fuzz:files": "node scripts/formats/fuzz/run.mjs",
    "fuzz:files:chembl": "node scripts/formats/fuzz/run.mjs --molecules bench/data/b1-chembl.smi,bench/data/b3-bridged.smi,bench/data/b3-fused.smi,bench/data/b3-macrocyclic.smi",
    "test": "node --test tests/*.test.mjs",
    "bench": "node bench/run-all.mjs",
    "bench:b1": "node --import ./bench/lib/setup.mjs bench/b1-valence.mjs",
    "bench:b2": "node --import ./bench/lib/setup.mjs bench/b2-projections.mjs",
    "bench:b3": "node --import ./bench/lib/setup.mjs bench/b3-redraw.mjs",
    "bench:b4": "node --import ./bench/lib/setup.mjs bench/b4-arrows.mjs",
    "bench:b5": "node --import ./bench/lib/setup.mjs bench/b5-conformations.mjs",
    "bench:b2d": "node --import ./bench/lib/setup.mjs bench/b2d-fischer.mjs",
    "bench:b6": "node --import ./bench/lib/setup.mjs bench/b6-canonical.mjs",
    "bench:report": "node bench/make-report.mjs",
    "report:other-programs": "node scripts/other-programs-report.mjs",
    "manual:web": "node scripts/manual-web.mjs"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.9.1",
    "indigo-ketcher": "1.46.0",
    "megane-rdkit": "0.1.0",
    "openchemlib": "9.25.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
